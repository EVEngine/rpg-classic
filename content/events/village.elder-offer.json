{
  "schema": "eve.rpgc.event",
  "version": 1,
  "id": "village.elder-offer",
  "title": "村庄长者 · 委托",
  "repeatable": true,
  "trigger": {
    "kind": "object_interacted",
    "mapId": "village-outskirts",
    "objectName": "elder"
  },
  "steps": [
    {
      "kind": "camera_focus",
      "x": 1360,
      "y": 736,
      "zoom": 1.5,
      "duration": 0.5
    },
    {
      "kind": "face_actor",
      "actorId": "elder",
      "facingX": -1,
      "facingY": 0
    },
    {
      "kind": "wait",
      "duration": 0.3
    },
    {
      "kind": "dialogue",
      "reference": "story.village.elderOffer"
    },
    {
      "kind": "branch",
      "condition": {
        "kind": "variable",
        "name": "gold",
        "compare": "gte",
        "value": 10
      },
      "then": [
        {
          "kind": "message",
          "reference": "gameplayLog.story.elderPaid"
        },
        {
          "kind": "set_variable",
          "name": "gold",
          "op": "sub",
          "value": 10
        },
        {
          "kind": "play_animation",
          "anim": "hero",
          "clip": "cast",
          "actorId": "player"
        }
      ],
      "else": [
        {
          "kind": "message",
          "reference": "gameplayLog.story.elderNotEnoughGold"
        },
        {
          "kind": "set_variable",
          "name": "quest.slayer",
          "op": "set",
          "value": 1
        }
      ]
    }
  ]
}
