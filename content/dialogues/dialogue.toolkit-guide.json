            "value": 0
          },
          "commands": [
            {
              "kind": "set_variable",
              "name": "toolkit.guide.accepted",
              "op": "set",
              "value": 1
            }
          ]
        },
        {
          "id": "recap",
          "textKey": "guide.recap",
          "next": "accepted",
          "condition": {
